      "template": "kinetic",
      "duration": 5.0,
      "data": {
        "eyebrow": "STARTER",
        "title": "这是我的第一支片子",
        "subtitle": "改 project.json 就能改画面",
        "footer": "1280 x 720 - 30 fps"
      }
    },
    {
      "id": "points",
      "template": "kinetic",
      "duration": 6.0,
      "data": {
        "eyebrow": "HOW IT WORKS",
        "title": "三段式最稳",
        "subtitle": "开场、正文、收尾",
        "rows": [
          { "label": "OPEN", "value": "一句话给出结论", "weight": 1.0, "color": "#e0455f" },
          { "label": "BODY", "value": "每条只讲一件事", "weight": 0.8, "color": "#38bdf8" },
          { "label": "CLOSE", "value": "回到开头那句话", "weight": 0.6, "color": "#a78bfa" }
        ],
        "footer": "edit me"
      }
    },
    {
      "id": "outro",
      "template": "kinetic",
      "duration": 4.0,
      "data": { "eyebrow": "NEXT", "title": "换成你的素材", "subtitle": "把图片丢进 assets/ 就自动用上" }
    }
  ],
  "timeline": [
    { "segment": "title" },
    { "segment": "points", "transition": { "type": "fade", "duration": 0.5 } },
    { "segment": "outro", "transition": { "type": "fade", "duration": 0.5 } }
  ]
}
